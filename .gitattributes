# Force LF line endings for all text files
* text=auto eol=lf

# Explicitly LF for scripts and code
*.sh    text eol=lf
*.rs    text eol=lf
*.toml  text eol=lf
*.sql   text eol=lf
*.md    text eol=lf
*.json  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
Dockerfile text eol=lf
Caddyfile  text eol=lf
